# Software credentials - OAuth client from Google Cloud Console (Web application type).
# Add Authorized redirect URIs matching this app's deployment(s):
#   http://localhost:3000/api/oauth2callback   (local dev)
#   https://<your-vercel-domain>/api/oauth2callback   (each deployment)
YT_CLIENT_ID=your-client-id.apps.googleusercontent.com
YT_CLIENT_SECRET=your-client-secret

# Optional: if set, /api/auth requires this exact value as ?secret=... before
# starting the OAuth flow, so random visitors to the deployed URL can't
# trigger it. Leave unset to skip this check.
ADMIN_SECRET=
